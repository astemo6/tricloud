# TriCloud 环境变量配置示例
# 用法：cp .env.example .env，然后按需修改；.env 已在 .gitignore 中，不会进仓库

# 面板登录密码（必填）。只在首次启动时用于初始化，之后请在面板「设置」里修改
PANEL_PASSWORD=<redacted>

# 凭证加密密钥（可选）。留空则首次启动时自动生成并保存到 data/fernet.key
# FERNET_KEY=

# 数据目录（可选），默认 ./data
# DATA_DIR=./data

# 登录会话有效期，秒（可选），默认 7200（2 小时，滑动过期）
# SESSION_TTL_SECONDS=7200

# 后台任务并发数（可选），默认 4
# JOB_WORKERS=4

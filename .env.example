# 复制为 .env 后修改。.env 已在 .gitignore 中，切勿提交。
# 首次启动的面板密码（仅在数据库中尚无密码时生效；留空则随机生成并打印到日志）
PANEL_PASSWORD=
# 通过 HTTPS 访问时设为 true（Cookie 加 Secure 标记）
COOKIE_SECURE=false
# 位于 Nginx / Cloudflare 后面时设为 true，用于登录限速识别真实 IP
TRUST_PROXY=false
# 会话有效期（小时）
SESSION_TTL_HOURS=168
# 登录失败锁定：连续失败次数 / 锁定分钟
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

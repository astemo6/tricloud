<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1420"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加云账号"
            android:textSize="20sp"
            android:textColor="#e6e9f0"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="云厂商"
            android:textColor="#8b93ad"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="别名"
            android:textColor="#8b93ad"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如 AWS-主账号"
            android:textColor="#e6e9f0"
            android:textColorHint="#5a6480"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llCreds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存并验证"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存时会自动校验凭证，失败会提示原因"
            android:textColor="#5a6480"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1420"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="20sp"
            android:textColor="#e6e9f0"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改面板密码"
            android:textColor="#e6e9f0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOldPwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="原密码"
            android:inputType="textPassword"
            android:textColor="#e6e9f0"
            android:textColorHint="#5a6480"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etNewPwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="新密码（至少 6 位）"
            android:inputType="textPassword"
            android:textColor="#e6e9f0"
            android:textColorHint="#5a6480" />

        <Button
            android:id="@+id/btnChangePwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修改密码"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telegram 通知"
            android:textColor="#e6e9f0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/etTgToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bot Token"
            android:inputType="textPassword"
            android:textColor="#e6e9f0"
            android:textColorHint="#5a6480"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etTgChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chat ID"
            android:inputType="number"
            android:textColor="#e6e9f0"
            android:textColorHint="#5a6480" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnTgSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存" />

            <Button
                android:id="@+id/btnTgTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发送测试"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
